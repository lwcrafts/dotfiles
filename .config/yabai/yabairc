#!/bin/sh

# 基础 yabai 配置
# 文档: https://github.com/asmvik/yabai/wiki

# ======================== 全局设置 ========================

# 默认布局: bsp 自动平铺；需要临时浮动时可用 skhd 绑定切换
# 可选: bsp | stack | float
yabai -m config layout bsp
# 新窗口默认放在当前窗口右侧/下方
yabai -m config window_placement second_child
# 新窗口分割比例
yabai -m config split_ratio 0.50
# 自动平衡窗口大小：off 更符合手动调整习惯；想自动均分可改为 on
yabai -m config auto_balance off
# 窗口间距与屏幕边距
yabai -m config window_gap 8
# 默认给 SketchyBar 预留空间；display_profile.sh 会单独调整 MBP 内屏
# yabai -m config top_padding "$BASE_TOP_PADDING"
yabai -m config bottom_padding 10
yabai -m config left_padding 10
yabai -m config right_padding 10
# 关闭 yabai 自带透明度/阴影，减少视觉干扰
yabai -m config window_opacity off
yabai -m config window_shadow off
# 鼠标辅助：按住 fn + 鼠标左键拖动窗口，fn + 右键调整窗口大小
yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off

# ======================== 静态窗口规则 ========================

# 系统工具与偏好设置
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Dictionary$" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Keychain Access$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^ColorSync Utility$" manage=off
yabai -m rule --add app="^Photo Booth$" manage=off

# 常见应用 / 弹窗
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^Music$" manage=off

# 匹配常见应用的设置窗口（标题以 Preferences 或 Settings 结尾）
yabai -m rule --add title="Preferences$" manage=off
yabai -m rule --add title="Settings$" manage=off

# 针对个别应用如微信等的浮动窗口（通常无标题）
yabai -m rule --add app="^WeChat$" title="^$" manage=off
yabai -m rule --add app="^QQ$" title="^$" manage=off
yabai -m rule --add app="^Telegram$" title="^$" manage=off

# 开发工具
yabai -m rule --add app="^Simulator$" title="^$" manage=off

# 游戏
yabai -m rule --add app="^Black Desert Mobile$" manage=off
# ======================== 启动时应用动态 Profile ========================

PROFILE_SCRIPT="${HOME}/.config/yabai/display_profile.sh"

# 清除旧关联
yabai -m signal --remove "display_added_padding" 2>/dev/null
yabai -m signal --remove "display_removed_padding" 2>/dev/null
yabai -m signal --remove "display_created_padding" 2>/dev/null

yabai -m signal --add label="display_added_padding" event=display_added action="$PROFILE_SCRIPT"
yabai -m signal --add label="display_removed_padding" event=display_removed action="$PROFILE_SCRIPT"
yabai -m signal --add label="space_created_padding" event=space_created action="$PROFILE_SCRIPT"

$PROFILE_SCRIPT &

# ======================== 显示器 / Space 拓扑 Signals ========================

