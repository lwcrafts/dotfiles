{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "palette": {
    "surface": "#e1e2e7",
    "foreground": "#3760bf",
    "blue": "#2e7de9",
    "cyan": "#007197",
    "green": "#587539",
    "yellow": "#8c6c3e",
    "orange": "#b15c00",
    "red": "#f52a65",
    "magenta": "#9854f1",
    "comment": "#848cb5",
    "selection": "#b7c1e3"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:surface",
          "background": "p:blue",
          "options": {
            "style": "powerlevel",
            "mapped_locations": {
              "~/ghq/github.com": "",
              "~/.config": ""
            }
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "trailing_diamond": "",
          "leading_diamond": "",
          "foreground": "p:surface",
          "background": "p:green",
          "template": "{{ .HEAD }}",
          "options": {}
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hidden",
      "segments": [
        {
          "type": "executiontime",
          "foreground": "p:comment",
          "template": " 󰌐 {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "austin"
          }
        },
        {
          "type": "node",
          "foreground": "p:green",
          "options": {
            "fetch_package_manager": true
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:comment",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if .Error }}p:red{{ end }}"
          ],
          "template": "{{ if .Error }} {{ .Code }}{{ else }}❯{{ end }} ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
